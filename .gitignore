.DS_Store
*.swp
*.swo
*~
.env
node_modules/
__pycache__/
# Empty lockfile generated by the remote env's `npm install` (repo has no package.json)
package-lock.json

# Local-only Claude Code settings (dev hooks, personal config)
.claude/settings.local.json

# Agent collaboration scratchpad (transient working files)
.claude/scratchpad/

# Memory files (created at runtime in consumer repos, not part of plugin source)
.claude/memory/

# Ephemeral activity log — written only when the repo has no context/ (dev/dogfood).
# In consumer repos the durable audit trail lives in context/audit/ and IS committed.
.claude/logs/

# MCP server config (contains API keys)
.mcp.json
